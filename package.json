{
  "name": "onething",
  "version": "0.1.0",
  "private": true,
  "description": "A phone-first planner that shows the one thing to do now. Runs free on Cloudflare, thinks with your own Claude.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "demo": "node tools/demo.mjs",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run --config test/vitest.config.ts && node --test test/tools/tools.test.mjs",
    "proof": "vitest run --config test/vitest.config.ts test/proof",
    "e2e": "playwright test --config test/e2e/playwright.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "mcp": "node tools/mcp/server.mjs",
    "runner": "node tools/runner/run.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261007.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
